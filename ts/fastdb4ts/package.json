{
  "name": "fastdb4ts",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript bindings for fastdb running in the browser via WebAssembly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/wasm"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "bash ../build-wasm.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
