{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fastdb:schema:fastdb.payload.v1",
  "title": "FastDB portable payload source document V1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "fastdb.payload.v1"
    },
    "profile": {
      "enum": [
        "record.v1",
        "object_graph.v1"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "entries",
    "components"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cardinality": {
          "enum": [
            "one",
            "many"
          ]
        },
        "type": {
          "$ref": "#/$defs/type"
        }
      },
      "required": [
        "id",
        "cardinality",
        "type"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "record"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "fields"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/type"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "type": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "bool",
                "u8",
                "u16",
                "u32",
                "i32",
                "f32",
                "f64",
                "str",
                "wstr",
                "bytes"
              ]
            },
            "nullable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "u8n",
                "u16n"
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "nullable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "component"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "nullable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ref"
            },
            "target": {
              "$ref": "#/$defs/id"
            },
            "nullable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "list"
            },
            "items": {
              "$ref": "#/$defs/type"
            },
            "nullable": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "items"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
